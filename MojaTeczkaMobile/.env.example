# Public configuration only. These values are not secrets and are included in the app bundle.
# Required for initial account sign-in. Use the central account service's HTTPS origin.
# Do not expose the prototype publicly before completing its security review.
# 127.0.0.1 refers to the phone itself and cannot point to the desktop service.
EXPO_PUBLIC_CENTRAL_ACCOUNT_URL=
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
