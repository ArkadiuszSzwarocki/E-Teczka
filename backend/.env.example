# Stripe test mode only. Never commit real keys.
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_PRICE_MONTHLY=price_replace_me
STRIPE_PRICE_YEARLY=price_replace_me
STRIPE_STANDARD_PRICE_MONTHLY=price_replace_me
STRIPE_STANDARD_PRICE_YEARLY=price_replace_me
# In Stripe test mode, when the two price IDs are empty, the app uses
# 9.99 PLN/month and 99.90 PLN/year automatically for Premium testing;
# Standard test checkout uses 4.99 PLN/month and 49.90 PLN/year.
STRIPE_WEBHOOK_SECRET=whsec_replace_me
ETECZKA_BILLING_SUCCESS_URL=https://example.com/billing/success
ETECZKA_BILLING_CANCEL_URL=https://example.com/billing/cancel
# OAuth cloud integrations (Premium)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Central account API. Do not enable until the server has been deployed securely.
ETECZKA_CENTRAL_ACCOUNT_URL=
DROPBOX_CLIENT_ID=
DROPBOX_CLIENT_SECRET=
ONEDRIVE_CLIENT_ID=
ONEDRIVE_CLIENT_SECRET=
# Local test callback (use this while backend runs on this computer):
# ETECZKA_OAUTH_CALLBACK_URL=http://localhost:3000/api/backup/oauth/callback
# Production callback (use after arecki.pl points to the backend):
ETECZKA_OAUTH_CALLBACK_URL=https://arecki.pl/api/backup/oauth/callback

# Desktop password recovery. Configure a sender mailbox before enrolling a
# recovery address in the application. Keep the password only in local .env.
ETECZKA_SMTP_HOST=
ETECZKA_SMTP_PORT=465
ETECZKA_SMTP_USER=
ETECZKA_SMTP_PASSWORD=
ETECZKA_SMTP_FROM=

# Optional PDF/A-2b for image scans: veraPDF installation and an RGB ICC profile.
ETECZKA_VERAPDF_DIR=
ETECZKA_PDFA_ICC=
ETECZKA_PDFA_TMP=

# Private test service for expiring document links; HTTPS only.
ETECZKA_SHARE_SERVICE_URL=
ETECZKA_SHARE_SERVICE_SECRET=
