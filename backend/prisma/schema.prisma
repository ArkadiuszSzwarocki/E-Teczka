generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./eteczka.db"
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  name      String?
  passwordHash String?
  role      String   @default("USER")
  createdAt DateTime @default(now())
  documents Document[]
  folders   Folder[] @relation("FolderOwner")
  sharedFolders FolderShare[]
  sessions AuthSession[]
}

model AuthSession {
  id        Int      @id @default(autoincrement())
  tokenHash String   @unique
  userId    Int
  expiresAt DateTime
  createdAt DateTime @default(now())
  deviceId String?
  deviceName String?
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Durable receipts make retries of offline operations safe after a lost response.
model SyncOperation {
  ownerKey    String
  operationId String
  result      String
  createdAt   DateTime @default(now())

  @@id([ownerKey, operationId])
  @@index([createdAt])
}

model Subscription {
  id                     Int      @id @default(autoincrement())
  ownerKey               String   @unique
  provider               String   @default("stripe")
  providerCustomerId     String?
  providerSubscriptionId String?  @unique
  plan                   String   @default("free")
  status                 String   @default("inactive")
  currentPeriodEnd       DateTime?
  cancelAtPeriodEnd      Boolean  @default(false)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
}

model BackupDestination {
  id           Int      @id @default(autoincrement())
  ownerKey     String   @unique
  provider     String
  endpoint     String?
  remoteFolder String?
  schedule     String?   @default("manual")
  lastBackupAt DateTime?
  lastBackupStatus String?
  lastBackupError String?
  encryptedCredentials String?
  enabled      Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  runs         BackupRun[]
}

model BackupRun {
  id            Int      @id @default(autoincrement())
  destinationId Int
  destination   BackupDestination @relation(fields: [destinationId], references: [id], onDelete: Cascade)
  status        String
  error         String?
  startedAt     DateTime @default(now())
  finishedAt    DateTime?
  @@index([destinationId, startedAt])
}

model BillingTransaction {
  id                     Int      @id @default(autoincrement())
  ownerKey               String
  provider               String   @default("stripe")
  providerReference      String   @unique
  providerSubscriptionId String?
  type                   String
  status                 String
  amount                 Int
  currency               String   @default("pln")
  description            String?
  occurredAt             DateTime @default(now())
  createdAt              DateTime @default(now())
}

model Folder {
  id        Int      @id @default(autoincrement())
  name      String
  parentId  Int?
  parent    Folder?  @relation("SubFolders", fields: [parentId], references: [id])
  children  Folder[] @relation("SubFolders")
  ownerId   Int
  owner     User     @relation("FolderOwner", fields: [ownerId], references: [id])
  documents Document[]
  shares    FolderShare[]
  createdAt DateTime @default(now())

  order Int @default(0)

  updatedAt DateTime @updatedAt @default(now())
}

model FolderShare {
  folderId   Int
  userId     Int
  permission String @default("VIEW")
  createdAt  DateTime @default(now())
  folder     Folder @relation(fields: [folderId], references: [id], onDelete: Cascade)
  user       User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([folderId, userId])
}

model Document {
  thumbnail String?
  ocrText   String?

  id               Int       @id @default(autoincrement())
  title            String
  filePath         String
  mimeType         String
  folderId         Int
  folder           Folder    @relation(fields: [folderId], references: [id])
  tags             DocumentTag[]
  userId Int?
  user User? @relation(fields: [userId], references: [id])
  retentionEnabled Boolean   @default(true)
  retentionValue   Int       @default(5)
  retentionUnit    String    @default("years")
  isArchived       Boolean   @default(false)
  isDeleted        Boolean   @default(false)
  deletedAt        DateTime?
  physicalLocation String?
  createdAt        DateTime  @default(now())

  updatedAt DateTime @updatedAt @default(now())
}

model Tag {
  id        Int           @id @default(autoincrement())
  name      String        @unique
  color     String        @default("#2563eb")
  documents DocumentTag[]
  owners PlanTagOwner[]
  createdAt DateTime      @default(now())
}

model DocumentTag {
  documentId Int
  tagId      Int
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  tag        Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([documentId, tagId])
}

// Persistent trial and seven-day usage accounting.
model PlanTrial {
  ownerKey String
  feature String
  startedAt BigInt
  @@id([ownerKey, feature])
}
model PlanUsage {
  ownerKey String
  feature String
  operationId String
  amount Int
  usedAt BigInt
  @@id([ownerKey, feature, operationId])
  @@index([ownerKey, feature, usedAt], map: "PlanUsage_window_idx")
}
model PlanPrinterClaim {
  ownerKey String
  jobId String
  draftId String
  @@id([ownerKey, jobId])
}
model PlanScanReceipt {
  ownerKey String
  draftId String
  documentId Int
  fingerprint String
  @@id([ownerKey, draftId])
}
model PlanTagOwner {
  ownerId Int
  tagId Int
  tag Tag @relation(fields: [tagId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  @@id([ownerId, tagId])
}
model PlanMeta {
  key String @id
}
