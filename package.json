{
    "name":  "eteczka-master",
    "version":  "1.0.0",
    "scripts":  {
                    "start":  "concurrently \"npm run start:backend\" \"npm run start:frontend\"",
                    "dev:desktop": "concurrently -k \"npm run start:backend\" \"npm run start:frontend\" \"npm run start:electron-dev\"",
                    "start:backend":  "cd backend \u0026\u0026 npx nodemon index.ts",
                    "start:frontend":  "cd frontend \u0026\u0026 npm run dev",
                    "start:electron-dev": "wait-on tcp:3000 http://127.0.0.1:5173 \u0026\u0026 set ETECZKA_DEV_URL=http://127.0.0.1:5173\u0026\u0026 set ETECZKA_EXTERNAL_BACKEND=1\u0026\u0026 electron ."
                },
    "devDependencies":  {
                            "concurrently":  "^8.2.2",
                            "electron":  "^44.4.3",
                            "electron-builder":  "^26.15.3",
                            "wait-on":  "^9.1.0"
                        },
    "main":  "main.js"
}
