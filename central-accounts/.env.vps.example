# Copy this file to .env.vps on the VPS server and fill in real secrets.
# Generate 64-char hex keys with: openssl rand -hex 32

CENTRAL_PUBLIC_ORIGIN=https://konto.arecki.pl
CENTRAL_VERIFY_URL=https://konto.arecki.pl/verify
CENTRAL_APP_URL=

# Trusted reverse proxy IP seen by the Docker container (gateway of compose.vps.yml internal bridge).
# Leave CENTRAL_TRUSTED_CLOUDFLARED_IP empty when using CENTRAL_TRUSTED_PROXY_IP (mutually exclusive).
CENTRAL_TRUSTED_PROXY_IP=172.30.0.1
CENTRAL_TRUSTED_CLOUDFLARED_IP=

# MariaDB credentials
CENTRAL_MARIADB_DATABASE=E-Teczka
CENTRAL_MARIADB_USER=mojateczka_user
CENTRAL_MARIADB_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD
MARIADB_ROOT_PASSWORD=CHANGE_ME_STRONG_ROOT_PASSWORD

# Required security keys (64 hex chars for CENTRAL_RATE_LIMIT_KEY, base64 PKCS#8 Ed25519 for entitlements)
CENTRAL_RATE_LIMIT_KEY=CHANGE_ME_64_HEX_CHARS
CENTRAL_ENTITLEMENT_PRIVATE_KEY=CHANGE_ME_BASE64_ED25519_PKCS8_KEY
CENTRAL_CATALOG_ADMIN_TOKEN=CHANGE_ME_MIN_43_CHARS_RANDOM_TOKEN

# SMTP mail server (required by central-accounts/index.js)
CENTRAL_SMTP_HOST=
CENTRAL_SMTP_PORT=465
CENTRAL_SMTP_USER=
CENTRAL_SMTP_PASSWORD=
CENTRAL_SMTP_FROM=

# Google Sign-In (comma-separated list of allowed OAuth client IDs; web client ID must be included in list)
CENTRAL_GOOGLE_CLIENT_IDS=
CENTRAL_GOOGLE_WEB_CLIENT_ID=

# Cloudflare Turnstile (optional — leave empty while native mobile app signs in without Turnstile token)
CENTRAL_TURNSTILE_SITE_KEY=
CENTRAL_TURNSTILE_SECRET_KEY=

# Desktop installer links for /pc landing page and "Send link to my e-mail"
CENTRAL_DESKTOP_WIN_URL=
CENTRAL_DESKTOP_MAC_URL=

# Encrypted expiring document links (/share) — optional
SHARE_MASTER_KEY=
SHARE_PUBLISH_SECRET=
SHARE_PUBLIC_BASE=https://konto.arecki.pl
