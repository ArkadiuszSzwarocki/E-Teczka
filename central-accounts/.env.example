# Konfiguracja połączenia z MariaDB dla usługi kont centralnych.
CENTRAL_MARIADB_HOST=192.168.0.12
CENTRAL_MARIADB_PORT=3307
CENTRAL_MARIADB_DATABASE=E-Teczka
CENTRAL_MARIADB_USER=mojateczka_app
CENTRAL_MARIADB_PASSWORD=
CENTRAL_GOOGLE_CLIENT_IDS=
CENTRAL_GOOGLE_WEB_CLIENT_ID=
CENTRAL_ENTITLEMENT_PRIVATE_KEY=
CENTRAL_CATALOG_ADMIN_TOKEN=
# Google Play billing is separate from Google Sign-In. Exact product IDs map to standard/premium.
CENTRAL_GOOGLE_PLAY_PACKAGE=
CENTRAL_GOOGLE_PLAY_PRODUCTS={}
# Base64-encoded service account JSON; server only.
CENTRAL_GOOGLE_PLAY_SERVICE_ACCOUNT=
CENTRAL_SMTP_HOST=
CENTRAL_SMTP_PORT=465
CENTRAL_SMTP_USER=
CENTRAL_SMTP_PASSWORD=
CENTRAL_SMTP_FROM=
CENTRAL_VERIFY_URL=https://konto.example.invalid/verify
CENTRAL_PORT=3001
CENTRAL_LISTEN_HOST=127.0.0.1
# Set only with an isolated connector network and verified connector IP.
CENTRAL_TRUSTED_CLOUDFLARED_IP=
# Persistent 32-byte hexadecimal key for privacy-preserving rate-limit identifiers.
CENTRAL_RATE_LIMIT_KEY=
# Optional Cloudflare Turnstile bot protection for public registration/login.
CENTRAL_TURNSTILE_SITE_KEY=
CENTRAL_TURNSTILE_SECRET_KEY=

# Opcjonalny adres aplikacji po zalogowaniu w przeglądarce.
CENTRAL_APP_URL=http://127.0.0.1:5173/?account=login
