{
  "expo": {
    "name": "MojaTeczka",
    "slug": "e-teczka-mobile",
    "scheme": "eteczka",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "pl.arecki.mojateczka",
      "infoPlist": {
        "NSCameraUsageDescription": "MojaTeczka używa aparatu wyłącznie do skanowania dokumentów i paragonów.",
        "NSPhotoLibraryUsageDescription": "MojaTeczka potrzebuje dostępu do zdjęć, aby dodawać zapisane dokumenty do archiwum.",
        "NSFaceIDUsageDescription": "MojaTeczka używa Face ID do szybkiego i bezpiecznego odblokowania dokumentów."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0F172A",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "pl.arecki.mojateczka"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-navigation-bar",
        {
          "hidden": true,
          "enforceContrast": false
        }
      ],
      "expo-secure-store",
      "./plugins/withLocalTls",
      "expo-notifications",
      [
        "react-native-document-scanner-plugin",
        {
          "cameraPermission": "MojaTeczka używa aparatu wyłącznie do skanowania dokumentów."
        }
      ]
    ]
  }
}
